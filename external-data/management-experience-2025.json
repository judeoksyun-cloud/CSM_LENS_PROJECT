  "periodSelectionPolicy": {
    "frequency": "annual_only",
    "q1ToQ3": "직전 연말을 당기로 선택",
    "q4OrYearEnd": "해당 연말을 당기로 선택",
    "prior": "당기의 직전 연말만 전기로 사용하며 미수록이면 null"
  },
  "validationPolicy": {
    "componentStatus": "official_component_recalculated",
    "reportedStatus": "official_reported_outcome",
    "missingRule": "동일 SAP 기준 예상금액 분모가 없으면 비율을 null로 유지하고 다른 지표로 대체하지 않는다.",
    "requiredTrace": ["publisher", "document", "scope", "location", "url", "coverageNote"]
  },
  "formulas": {
    "total": "보험금 예실차 + 사업비 예실차",
    "claim": "예상보험금 - (발생보험금 + 발생사고요소조정)",
    "expense": "(예상손해조사비 + 예상계약유지비 + 예상투자관리비) - (발생손해조사비 + 발생계약유지비 + 발생투자관리비)",
    "totalRatio": "종합 예실차 / (예상보험금 + 예상사업비)",
    "claimRatio": "보험금 예실차 / 예상보험금",
    "expenseRatio": "사업비 예실차 / 예상사업비"
  },
  "guidance": {
    "thresholdPercent": 5,
    "displayStatus": "context_only",
    "note": "업무상 관리 참고선은 ±5% 이내로 설정한다. 회사가 예상금액 분모를 공개하지 않은 세부 지표는 비율을 산출하지 않고 공개 범위 그대로 표시한다."
  },
